+ */
+const tokenIdUnsupportedOrigins = new Set<string>()
+const tokenIdProbeMisses = new Map<string, number>()
+
+function endpointOrigin(baseUrl: string): string {
+  try {
+    return new URL(baseUrl).origin
+  } catch {
+    return baseUrl
+  }
+}
