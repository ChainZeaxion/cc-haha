+  let lastData = own.lastDataTime()
+  for (const m of subordinates) {
+    if (m.lastDataTime() > lastData) lastData = m.lastDataTime()
+  }
+  if (lastData > 0 && now - lastData > hideAfterIdleMs) {
+    return { visible: false, tps: 0, activeSubs: 0 }
+  }
