+  let tps = own.hasLiveSamples() ? own.value() : 0
+  let activeSubs = 0
+  for (const meter of subordinates) {
+    if (!meter.hasLiveSamples()) continue
+    activeSubs += 1
+    tps += meter.value()
+  }
+  if (tps <= 0) {
