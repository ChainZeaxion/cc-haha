+    && Number.isFinite(calibration.kAscii) && calibration.kAscii > 0
+    ? {
+        kCjk: clamp(calibration.kCjk, K_MIN, K_MAX),
+        kAscii: clamp(calibration.kAscii, K_MIN, K_MAX),
