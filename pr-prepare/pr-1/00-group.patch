+  // calibration means the same thing in both places.
+  const kCjk = estimationCalibration?.kCjk ?? DEFAULT_K_CJK
+  const kAscii = estimationCalibration?.kAscii ?? 1
+  return cjk * kCjk + ascii * kAscii
+}
