+export function formatThinkingTokens(text: string, thinkingTokens?: number): string {
+  const tokens = typeof thinkingTokens === 'number' && thinkingTokens > 0
+    ? thinkingTokens
+    : estimateTokens(text)
+  return `${(tokens / 1000).toFixed(2)}k`
