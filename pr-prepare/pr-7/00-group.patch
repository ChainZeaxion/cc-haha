+    for (let i = idx - 1; i >= Math.max(0, idx - 4); i--) {
+      if (ranked[i].block.kind === "assistant") {
+        add(ranked[i], 7, "near-important-event");
+        break;
+      }
+    }
+    for (let i = idx + 1; i <= Math.min(ranked.length - 1, idx + 4); i++) {
