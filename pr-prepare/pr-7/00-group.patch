+const boostAdjacency = (ranked: RankedBlock[]) => {
+  const important = ranked
+    .filter((r) => r.score >= 34 || r.reasons.includes("edit-tool") || r.reasons.includes("test-command") || r.reasons.includes("nonzero-exit"))
