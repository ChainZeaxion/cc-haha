+import '@testing-library/jest-dom/vitest'
+import { fireEvent, render, screen } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { useSettingsStore } from '@/stores/settingsStore'
+import { useUIStore } from '@/stores/uiStore'
+import { FileUnavailableDialog } from './FileUnavailableDialog'
+
+const download = vi.hoisted(() => vi.fn())
+vi.mock('@/lib/handlePreviewLink', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/lib/handlePreviewLink')>()),
+  downloadLocalFile: download,
+}))
+
+beforeEach(() => {
+  useSettingsStore.setState({ locale: 'en' })
+  download.mockReset()
+  useUIStore.setState({ unavailableFile: null })
+})
+
+describe('FileUnavailableDialog', () => {
+  it('stays out of the way until there is something to explain', () => {
+    render(<FileUnavailableDialog />)
+
+    expect(screen.queryByRole('dialog')).not.toBeInTheDocument()
+  })
+
+  it('names the file and offers the save that still gets it onto the device', () => {
+    useUIStore.setState({
+      unavailableFile: {
+        absolutePath: '/w/out/launch.pptx',
+        name: 'launch.pptx',
+        reason: 'no-viewer',
+        canDownload: true,
+      },
+    })
+    render(<FileUnavailableDialog />)
+
+    expect(screen.getByRole('dialog', { name: 'Can’t open in the page' })).toBeInTheDocument()
+    expect(screen.getByText(/launch\.pptx/)).toBeInTheDocument()
+
+    fireEvent.click(screen.getByRole('button', { name: 'Download' }))
+
+    expect(download).toHaveBeenCalledWith('/w/out/launch.pptx')
+    // Dismissed from the same action that saved it: an open dialog over a file
+    // the user already dealt with is just in the way.
+    expect(useUIStore.getState().unavailableFile).toBeNull()
+  })
+
+  it('closes without saving', () => {
+    useUIStore.setState({
+      unavailableFile: {
+        absolutePath: '/w/a.zip',
+        name: 'a.zip',
+        reason: 'no-viewer',
+        canDownload: true,
+      },
+    })
+    render(<FileUnavailableDialog />)
+
+    fireEvent.click(screen.getByRole('button', { name: 'Close' }))
+
+    expect(download).not.toHaveBeenCalled()
+    expect(useUIStore.getState().unavailableFile).toBeNull()
+  })
+
+  it('gives the size when the file was too large, not a bare refusal', () => {
+    useUIStore.setState({
+      unavailableFile: {
+        absolutePath: '/w/huge.bin',
+        name: 'huge.bin',
+        reason: 'too-large',
+        size: 24 * 1024 * 1024,
+        canDownload: true,
+      },
+    })
+    render(<FileUnavailableDialog />)
+
+    expect(screen.getByText(/24 MB/)).toBeInTheDocument()
+  })
+
+  it('says a file is outside the workspace rather than that nothing can draw it', () => {
+    useUIStore.setState({
+      unavailableFile: {
+        absolutePath: '/elsewhere/notes.md',
+        name: 'notes.md',
+        reason: 'outside-workspace',
+        canDownload: true,
+      },
+    })
+    render(<FileUnavailableDialog />)
+
+    expect(screen.getByText(/outside the workspace/)).toBeInTheDocument()
+    expect(screen.getByRole('button', { name: 'Download' })).toBeInTheDocument()
+  })
+
+  it('offers no save for a path the server cannot serve, since it could only fail', () => {
+    useUIStore.setState({
+      unavailableFile: {
+        absolutePath: '/var/secret.txt',
+        name: 'secret.txt',
+        reason: 'outside-workspace',
+        canDownload: false,
+      },
+    })
+    render(<FileUnavailableDialog />)
+
+    expect(screen.queryByRole('button', { name: 'Download' })).not.toBeInTheDocument()
+    expect(screen.getByRole('button', { name: 'Close' })).toBeInTheDocument()
+  })
+})
diff --git a/desktop/src/components/layout/FileUnavailableDialog.tsx b/desktop/src/components/layout/FileUnavailableDialog.tsx
new file mode 100644
index 00000000..6fbf9150
--- /dev/null
+++ b/desktop/src/components/layout/FileUnavailableDialog.tsx
@@ -0,0 +1,71 @@
+import { ActionDialog } from '@/components/ui/ActionDialog'
+import { useTranslation, type TranslationKey } from '@/i18n'
+import { formatBytes } from '@/lib/formatBytes'
+import { downloadLocalFile } from '@/lib/handlePreviewLink'
+import { useUIStore, type UnavailableFile } from '@/stores/uiStore'
+
+/**
+ * The way out when the user asked to open a file this runtime cannot open.
+ *
+ * Only the runtimes without a system shell reach it: there the file used to be
+ * launched on the *server's* desktop, which is where nobody was looking. A save
+ * to the device is the one action that still gets the user the file, so it is the
+ * action offered when it can work.
+ *
+ * Which reason it gives is the useful part — "too large", "outside the workspace"
+ * and "nothing here can draw this" are three different situations, and a single
+ * "could not open" would leave the user guessing which one they hit.
+ *
+ * Mounted once per shell, beside the toasts — see `AppShell`.
+ */
+export function FileUnavailableDialog() {
+  const t = useTranslation()
+  const file = useUIStore((state) => state.unavailableFile)
+  const dismiss = useUIStore((state) => state.dismissFileUnavailable)
+
+  return (
+    <ActionDialog
+      open={file !== null}
+      onClose={dismiss}
+      title={t('workspace.fileUnavailable.title')}
+      body={t(bodyKeyFor(file), bodyVarsFor(file))}
+      actions={[
+        ...(file?.canDownload
+          ? [{
+              label: t('workspace.download'),
+              variant: 'primary' as const,
+              onClick: () => {
+                downloadLocalFile(file.absolutePath)
+                dismiss()
+              },
+            }]
+          : []),
+        { label: t('common.close'), onClick: dismiss },
+      ]}
+    />
+  )
+}
+
+/** The message is chosen by *why* it could not be opened, not by the file's kind. */
+function bodyKeyFor(file: UnavailableFile | null): TranslationKey {
+  switch (file?.reason) {
+    case 'too-large':
+      return 'workspace.fileUnavailable.tooLargeBody'
+    case 'outside-workspace':
+      // A path the server will not serve cannot be saved either, so it says that
+      // instead of offering a download that is certain to fail.
+      return file.canDownload
+        ? 'workspace.fileUnavailable.outsideBody'
+        : 'workspace.fileUnavailable.unreachableBody'
+    default:
+      return 'workspace.fileUnavailable.body'
+  }
+}
+
+function bodyVarsFor(file: UnavailableFile | null): Record<string, string> {
+  const vars: Record<string, string> = { name: file?.name ?? '' }
+  if (file?.reason === 'too-large' && typeof file.size === 'number') {
+    vars.size = formatBytes(file.size)
+  }
+  return vars
+}
