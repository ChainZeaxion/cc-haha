+import '@testing-library/jest-dom/vitest'
+import { fireEvent, render, screen } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { useSettingsStore } from '@/stores/settingsStore'
+import { MediaSurface } from './MediaSurface'
+
+vi.mock('@/lib/desktopRuntime', () => ({
+  getServerBaseUrl: () => 'http://127.0.0.1:4321',
+}))
+
+// Defaults to the browser host, which is where the media element matters most:
+// it is the only way the file plays on the device at all.
+const shell = vi.hoisted(() => ({ available: false }))
+vi.mock('@/lib/systemFileOpen', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/lib/systemFileOpen')>()),
+  canOpenWithSystem: () => shell.available,
+}))
+
+beforeEach(() => {
+  useSettingsStore.setState({ locale: 'en' })
+  shell.available = false
+})
+
+describe('MediaSurface', () => {
+  it('plays a video with the browser element, from a URL that can seek', () => {
+    render(<MediaSurface sessionId="s1" path="clip.mp4" absolutePath="/w/clip.mp4" />)
+
+    const video = screen.getByTestId('workspace-media-video')
+    // The filesystem route, not the `raw` document route: only this one streams
+    // with range support, without which a video cannot be seeked or scrubbed.
+    expect(video).toHaveAttribute('src', 'http://127.0.0.1:4321/local-file/w/clip.mp4')
+    expect(video).toHaveAttribute('controls')
+  })
+
+  it('plays audio with the audio element', () => {
+    render(<MediaSurface sessionId="s1" path="voice.mp3" absolutePath="/w/voice.mp3" />)
+
+    expect(screen.getByTestId('workspace-media-audio')).toHaveAttribute(
+      'src',
+      'http://127.0.0.1:4321/local-file/w/voice.mp3',
+    )
+  })
+
+  it('falls back to the session route when the path could not be rooted', () => {
+    // `workDir` has not loaded, so `absolutePath` is still the relative path: a
+    // `/local-file` URL built from it would name a file that is not there.
+    render(<MediaSurface sessionId="s1" path="out/clip.mp4" absolutePath="out/clip.mp4" />)
+
+    expect(screen.getByTestId('workspace-media-video')).toHaveAttribute(
+      'src',
+      'http://127.0.0.1:4321/preview-fs/s1/out/clip.mp4',
+    )
+  })
+
+  it('replaces a container the browser cannot decode with a way out', () => {
+    render(<MediaSurface sessionId="s1" path="film.mkv" absolutePath="/w/film.mkv" />)
+
+    fireEvent.error(screen.getByTestId('workspace-media-video'))
+
+    expect(screen.queryByTestId('workspace-media-video')).not.toBeInTheDocument()
+    expect(screen.getByRole('status')).toHaveTextContent('This media can’t be played here.')
+    // No system player exists on this runtime, so the way out is the save.
+    expect(screen.getByRole('button', { name: 'Download' })).toBeInTheDocument()
+  })
+
+  it('offers the system player for an undecodable container on the desktop', () => {
+    shell.available = true
+    render(<MediaSurface sessionId="s1" path="film.mkv" absolutePath="/w/film.mkv" />)
+
+    fireEvent.error(screen.getByTestId('workspace-media-video'))
+
+    expect(screen.getByRole('button', { name: 'Open in system app' })).toBeInTheDocument()
+  })
+})
diff --git a/desktop/src/components/workspace/surfaces/MediaSurface.tsx b/desktop/src/components/workspace/surfaces/MediaSurface.tsx
new file mode 100644
index 00000000..c7600ce5
--- /dev/null
+++ b/desktop/src/components/workspace/surfaces/MediaSurface.tsx
@@ -0,0 +1,83 @@
+import { useState } from 'react'
+import { useTranslation } from '@/i18n'
+import { getServerBaseUrl } from '@/lib/desktopRuntime'
+import { isRootedLocalPath, localFileUrl, previewFsUrl } from '@/lib/handlePreviewLink'
+import { isWorkspaceVideoFile } from '@/lib/fileCapabilities'
+import { OpenInSystemButton } from './OpenInSystemButton'
+import { PanelMessage } from './PanelMessage'
+
+/**
+ * The workspace's player for audio and video.
+ *
+ * Media is the one file kind the document viewers cannot cover. They read through
+ * the `raw` route, which serves whole documents and cannot seek — and a video that
+ * cannot seek is not playable — so this uses the filesystem routes, which stream
+ * with range support and let the browser's own element seek.
+ *
+ * The element gets a bare URL because an `<audio>`/`<video src>` cannot carry an
+ * Authorization header. That is also why media is the one preview the H5 surface
+ * plays *on the phone*: there, the same-origin subresource rule authorizes exactly
+ * these loads, and there is no system player to hand the file to instead.
+ *
+ * A container the browser cannot decode (`.mkv`, `.avi`) lands in the failure
+ * state rather than a broken element, which offers the system player on the
+ * desktop and a save everywhere else — see `OpenInSystemButton`.
+ */
+export function MediaSurface({
+  sessionId,
+  path,
+  absolutePath,
+}: {
+  sessionId: string
+  path: string
+  absolutePath: string
+}) {
+  const t = useTranslation()
+  const [failed, setFailed] = useState(false)
+
+  if (failed) {
+    return (
+      <PanelMessage
+        icon="movie"
+        message={t('workspace.mediaUnavailable')}
+        action={<OpenInSystemButton absolutePath={absolutePath} />}
+      />
+    )
+  }
+
+  const base = getServerBaseUrl()
+  // A path the workspace could root goes through the session-scoped route; one it
+  // could not (`workDir` has not loaded yet) would build a nonsense `/local-file`
+  // URL, so it keeps the relative form the preview route resolves server-side.
+  const src = isRootedLocalPath(absolutePath)
+    ? localFileUrl(base, absolutePath)
+    : previewFsUrl(base, sessionId, path)
+  const onError = () => setFailed(true)
+
+  if (isWorkspaceVideoFile(path)) {
+    return (
+      <video
+        data-testid="workspace-media-video"
+        src={src}
+        controls
+        preload="metadata"
+        playsInline
+        onError={onError}
+        className="max-h-full w-full bg-black"
+      />
+    )
+  }
+
+  return (
+    <div className="flex min-h-0 flex-1 items-center justify-center p-6">
+      <audio
+        data-testid="workspace-media-audio"
+        src={src}
+        controls
+        preload="metadata"
+        onError={onError}
+        className="w-full max-w-[520px]"
+      />
+    </div>
+  )
+}
