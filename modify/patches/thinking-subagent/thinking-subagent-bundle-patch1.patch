+type ToolResult = Extract<UIMessage, { type: 'tool_result' }>
+
+function agentCall(id: string, timestamp: number): ToolCall {
+  return {
+    id: `tool-${id}`,
+    type: 'tool_use',
+    toolName: 'Agent',
+    toolUseId: id,
+    input: { description: `Review ${id}` },
+    timestamp,
