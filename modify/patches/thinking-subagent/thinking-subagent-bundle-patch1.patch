+  tokens: ReadonlyArray<number | undefined>,
+): number | undefined {
+  let total = 0
+  let measured = false
+  for (const value of tokens) {
+    if (typeof value !== 'number' || !Number.isFinite(value) || value <= 0) continue
+    total += value
+    measured = true
+  }
+  return measured ? total : undefined
+}
+
