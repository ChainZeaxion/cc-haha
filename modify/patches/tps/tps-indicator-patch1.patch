+  // Push a steady ~60 tok/s stream into `meter` while advancing the fake clock.
+  function pump(meter: TpsMeter, nowRef: { t: number }, n = 10): void {
+    for (let i = 0; i < n; i++) {
+      nowRef.t += 100
